<!DOCTYPE HTML>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <title>Long Recognition Manual for SH4,TMO,SCAF. (Imperial Version)</title>
  <link rel="stylesheet" type="text/css" href="recogL.css" />


</head>
<body>
<div class=wrapper id="header">
<h1>Long Recognition Manual for SH4,TMO,SCAF. (Imperial Version)</h1>
</div>
<div class=wrapper>

    <div class=flag>
    </div>

    <div class=data>
        <div class = dataContainer id=n>
        &nbspName:&nbspname
        </div>

        <div class = dataContainer id=c>
        Class:&nbsptypeName
        </div>
    </div>

    <div class = ship>
        <img src="data:image/png;base64,imagePath" />
    </div>

    <div class=data style="width:100%" >

        <div class = dataContainer id=t>
        Tonnage:0 GRT
        </div>

        <div class = dataContainer id=s>
        &nbspSpeed:0 kt
        </div>

        <div class = dataContainer id=d>
        &nbspDraft:0 ft
        </div>

        <div class = dataContainer id=h>
        &nbspHeight:0 ft
        </div>

        <div class = dataContainer id=l>
        Length:0 ft
        </div>

        <div class = dataContainer id=a>
        Aspect:NaN
        </div>
    </div>
</div>
</body>
</html>
